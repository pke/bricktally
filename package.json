{
  "name": "bricktally",
  "version": "1.41.20",
  "description": "LEGO® set verification and brick counting app",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:unit": "node --test tests/unit/missing-share.test.js",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "build": "node scripts/build-i18n.js",
    "serve": "npm run build && node scripts/serve.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.41.0"
  },
  "keywords": [
    "lego",
    "brick",
    "verification",
    "inventory"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "pako": "^2.1.0"
  }
}
